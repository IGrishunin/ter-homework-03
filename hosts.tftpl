%{if length(webservers) > 0 ~}
[webservers]
%{for vm in webservers ~}
${vm.name}   ansible_host=%{if length(vm.network_interface[0].nat_ip_address) > 0}${vm.network_interface[0].nat_ip_address}%{else}${vm.network_interface[0].ip_address}%{endif} fqdn=${vm.fqdn}
%{endfor}
%{endif}
%{if length(databases) > 0 ~}
[databases]
%{for vm in databases ~}
${vm.name}   ansible_host=%{if length(vm.network_interface[0].nat_ip_address) > 0}${vm.network_interface[0].nat_ip_address}%{else}${vm.network_interface[0].ip_address}%{endif} fqdn=${vm.fqdn}
%{endfor}
%{endif}
%{if length(storages) > 0 ~}
[storages]
%{for vm in storages ~}
${vm.name}   ansible_host=%{if length(vm.network_interface[0].nat_ip_address) > 0}${vm.network_interface[0].nat_ip_address}%{else}${vm.network_interface[0].ip_address}%{endif} fqdn=${vm.fqdn}
%{endfor}
%{endif}
